{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NitPick",
  "version": "0.2.0",
  "identifier": "io.github.borasavkar.nitpick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NitPick",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Find your monitor's best settings",
    "longDescription": "NitPick helps anyone find their monitor's best brightness, contrast, gamma, color and sharpness settings with guided test patterns. No calibration hardware needed.",
    "publisher": "Bora Şavkar",
    "copyright": "© 2026 Bora Şavkar. MIT License.",
    "homepage": "https://github.com/borasavkar/nitpick",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Turkish"
        ]
      }
    }
  }
}